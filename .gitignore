# ============================================================
#  Music Hub - .gitignore
#  Keeps the repo to project source code + README only.
# ============================================================

# --- Dependencies ---
node_modules/

# --- Secrets & environment (NEVER expose API keys / secrets) ---
.env
.env.*
*.env

# --- Databases (runtime data) ---
*.sqlite
*.sqlite3
*.db

# --- User uploads (MP3s) ---
client/uploads/*
!client/uploads/.gitkeep

# --- Documentation & diagrams (keep only README.md) ---
*.md
!README.md
docs/
*.drawio
*.model.xml

# --- Large media / recordings ---
*.zip
*.mov
*.mp4

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / tooling ---
.claude/
.vscode/
.idea/
*.swp

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

