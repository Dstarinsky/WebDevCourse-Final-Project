# ============================================================
#  Music Hub - .gitignore
# ============================================================

# --- Dependencies ---
node_modules/

# --- Secrets & environment (NEVER expose API keys / secrets) ---
.env
.env.*
*.env
# ...but the sanitized template MUST be committed: the README tells users to copy it.
!.env.example
!**/.env.example

# --- Databases (runtime data) ---
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# --- User uploads (stored outside the web root, served via /media/:songId) ---
Server/storage/uploads/*
!Server/storage/uploads/.gitkeep
Server/backups/

# --- Large media / recordings ---
*.zip
*.mov
*.mp4

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / tooling / cache ---
.developer/
.vscode/
.idea/
*.swp
.eslintcache

# --- Testing / Coverage ---
test-results/
playwright-report/
blob-report/
coverage/
.nyc_output/

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Project documentation (README, DEVELOPER.md, WRITEUP.md, docs/ diagrams) is
# deliberately tracked. The previous "*.md except README" rule silently hid every
# design and review document from git status.
!docs/
!DEVELOPER.md
