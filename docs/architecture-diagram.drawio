<mxfile host="app.diagrams.net" type="device" version="24.0.0">
  <diagram id="musichub-architecture-v2" name="Music Hub - Current Architecture">
    <mxGraphModel dx="1200" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Music Hub — Current Runtime Architecture" style="text;html=1;align=center;fontSize=22;fontStyle=1;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="480" height="34" as="geometry" /></mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser UI&lt;/b&gt;&lt;br&gt;EJS + home.js / favorites.js / playlist.js&lt;br&gt;YouTube iframe or HTMLAudio player&lt;br&gt;Library ↔ Discover keeps the mounted media element" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9FD;strokeColor=#C6005C;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="350" y="80" width="500" height="90" as="geometry" /></mxCell>
        <mxCell id="express" value="&lt;b&gt;Express boundary&lt;/b&gt;&lt;br&gt;Helmet/CSP → 32 KB parsers → SQLite sessions → CSRF&lt;br&gt;rate limits → authentication → ownership middleware → routes/EJS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EAF4;strokeColor=#5C4B70;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="540" height="90" as="geometry" /></mxCell>
        <mxCell id="session" value="&lt;b&gt;SQLite session store&lt;/b&gt;&lt;br&gt;Only public user projection&lt;br&gt;rotated session ID + CSRF secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#046E7D;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="235" height="80" as="geometry" /></mxCell>
        <mxCell id="controllers" value="&lt;b&gt;Controllers&lt;/b&gt;&lt;br&gt;Auth · Favorite · Playlist · Media&lt;br&gt;HTML/JSON outcomes + private range streaming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9FD;strokeColor=#C6005C;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="370" y="360" width="460" height="75" as="geometry" /></mxCell>
        <mxCell id="services" value="&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;AuthService&lt;br&gt;YouTubeService&lt;br&gt;UploadService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4EB;strokeColor=#B4520A;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="repositories" value="&lt;b&gt;Repositories&lt;/b&gt;&lt;br&gt;UserRepository · FavoriteRepository&lt;br&gt;PlaylistRepository&lt;br&gt;parameterized SQL + transactions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFFAFA;strokeColor=#046E7D;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="430" y="490" width="340" height="100" as="geometry" /></mxCell>
        <mxCell id="youtube" value="&lt;b&gt;YouTube Data API v3&lt;/b&gt;&lt;br&gt;validated query/count&lt;br&gt;timeout + bounded cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F5;strokeColor=#C6005C;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="890" y="490" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="appdb" value="&lt;b&gt;music_app SQLite — migration v2&lt;/b&gt;&lt;br&gt;users · playlists · playlist_songs · favorites&lt;br&gt;FK cascades, checks, unique keys, ordered indexes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#046E7D;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="405" y="650" width="390" height="90" as="geometry" /></mxCell>
        <mxCell id="privateMedia" value="&lt;b&gt;Private audio storage&lt;/b&gt;&lt;br&gt;MP3 · M4A · OGG/OGA · WAV · FLAC · AAC&lt;br&gt;magic-byte verified; never express.static" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4EB;strokeColor=#B4520A;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="855" y="650" width="285" height="90" as="geometry" /></mxCell>
        <mxCell id="maintenance" value="&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;backup / restore / reconcile&lt;br&gt;foreign-key and file-lifecycle checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EAF4;strokeColor=#5C4B70;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="270" height="90" as="geometry" /></mxCell>
        <mxCell id="disk" value="Render Starter · single instance · persistent /var/data disk (DB, sessions, uploads, backups)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#241733;strokeColor=#241733;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="805" width="680" height="45" as="geometry" /></mxCell>
        <mxCell id="e1" value="request / fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5C4B70;" edge="1" parent="1" source="browser" target="express"><mxGeometry relative="1" as="geometry" /></mxCell>
