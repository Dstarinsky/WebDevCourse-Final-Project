<mxfile host="app.diagrams.net" type="device" version="24.0.0">
  <diagram id="musichub-auth-v2" name="Music Hub - Current Authentication">
    <mxGraphModel dx="1300" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="Music Hub — Authentication and Session Lifecycle" style="text;html=1;align=center;fontSize=22;fontStyle=1;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="375" y="18" width="550" height="34" as="geometry" /></mxCell>
        <mxCell id="form" value="GET /login or /register&lt;br&gt;issue synchronizer CSRF token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C4B70;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="300" height="65" as="geometry" /></mxCell>
        <mxCell id="gate" value="POST passes auth limiter + CSRF?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3EAF4;strokeColor=#C6005C;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="550" y="185" width="200" height="105" as="geometry" /></mxCell>
        <mxCell id="choice" value="Register or log in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4EB;strokeColor=#B4520A;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="560" y="335" width="180" height="95" as="geometry" /></mxCell>
        <mxCell id="register" value="&lt;b&gt;Register&lt;/b&gt;&lt;br&gt;normalize case-insensitive email&lt;br&gt;validate names + 15–128 char password&lt;br&gt;deny common passwords" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F5;strokeColor=#C6005C;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="100" y="470" width="305" height="105" as="geometry" /></mxCell>
        <mxCell id="login" value="&lt;b&gt;Log in&lt;/b&gt;&lt;br&gt;normalize email + bound password bytes&lt;br&gt;generic failure for missing user/wrong secret&lt;br&gt;timing-resistant missing-user work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFFAFA;strokeColor=#046E7D;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="895" y="470" width="305" height="105" as="geometry" /></mxCell>
        <mxCell id="hash" value="SHA-384 prehash → bcrypt&lt;br&gt;persist versioned password hash&lt;br&gt;UNIQUE email conflict → 409" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4EB;strokeColor=#B4520A;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="100" y="620" width="305" height="85" as="geometry" /></mxCell>
        <mxCell id="verify" value="Verify versioned or legacy bcrypt&lt;br&gt;successful legacy login upgrades hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFFAFA;strokeColor=#046E7D;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="895" y="620" width="305" height="85" as="geometry" /></mxCell>
        <mxCell id="session" value="Regenerate session ID&lt;br&gt;store { id, email, firstName } only&lt;br&gt;save → redirect /playlists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#241733;strokeColor=#241733;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="600" width="310" height="95" as="geometry" /></mxCell>
        <mxCell id="error" value="400 / 403 / 409 or generic 401&lt;br&gt;re-render form with safe message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F5;strokeColor=#C6005C;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="270" height="80" as="geometry" /></mxCell>
        <mxCell id="logout" value="POST /logout + CSRF&lt;br&gt;destroy session → clear musichub.sid&lt;br&gt;redirect /login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C4B70;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="500" y="715" width="300" height="65" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="form" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#C6005C;" edge="1" parent="1" source="gate" target="error"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="gate" target="choice"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="register" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#C6005C;" edge="1" parent="1" source="choice" target="register"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#046E7D;" edge="1" parent="1" source="choice" target="login"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="valid + unused email" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#B4520A;" edge="1" parent="1" source="register" target="hash"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#C6005C;" edge="1" parent="1" source="register" target="error"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#046E7D;" edge="1" parent="1" source="login" target="verify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#C6005C;" edge="1" parent="1" source="login" target="error"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="new user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="hash" target="session"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="verified user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="verify" target="session"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="later" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="session" target="logout"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
