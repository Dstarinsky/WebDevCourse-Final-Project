  <diagram id="musichub-schema-v2" name="Music Hub - Migration v2 Schema">
    <mxGraphModel dx="1320" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="Music Hub — Canonical SQLite Schema (user_version = 2)" style="text;html=1;align=center;fontSize=22;fontStyle=1;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="600" height="35" as="geometry" /></mxCell>
        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id INTEGER AUTOINCREMENT&lt;br&gt;&lt;b&gt;U&lt;/b&gt; email TEXT NOT NULL UNIQUE COLLATE NOCASE&lt;br&gt;firstName TEXT NOT NULL&lt;br&gt;lastName TEXT NOT NULL DEFAULT ''&lt;br&gt;passwordHash TEXT NOT NULL&lt;br&gt;createdAt TEXT NOT NULL" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;verticalAlign=top;fillColor=#FFF0F5;strokeColor=#C6005C;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="360" height="230" as="geometry" /></mxCell>
        <mxCell id="playlists" value="&lt;b&gt;playlists&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id INTEGER AUTOINCREMENT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; userId INTEGER NOT NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ users.id ON DELETE CASCADE&lt;br&gt;name TEXT NOT NULL&lt;br&gt;createdAt TEXT NOT NULL&lt;br&gt;position INTEGER NOT NULL DEFAULT 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;verticalAlign=top;fillColor=#EFFAFA;strokeColor=#046E7D;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="330" height="230" as="geometry" /></mxCell>
        <mxCell id="favorites" value="&lt;b&gt;favorites&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id INTEGER AUTOINCREMENT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; userId INTEGER NOT NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ users.id ON DELETE CASCADE&lt;br&gt;videoId TEXT NOT NULL&lt;br&gt;title TEXT NOT NULL&lt;br&gt;thumbnailUrl TEXT NULL&lt;br&gt;createdAt TEXT NOT NULL&lt;br&gt;&lt;b&gt;U&lt;/b&gt; UNIQUE(userId, videoId)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;verticalAlign=top;fillColor=#FFF4EB;strokeColor=#B4520A;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="910" y="120" width="340" height="255" as="geometry" /></mxCell>
        <mxCell id="songs" value="&lt;b&gt;playlist_songs&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id INTEGER AUTOINCREMENT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; playlistId INTEGER NOT NULL → playlists.id ON DELETE CASCADE&lt;br&gt;videoId TEXT NOT NULL&lt;br&gt;title TEXT NOT NULL&lt;br&gt;thumbnailUrl TEXT NULL&lt;br&gt;position INTEGER NOT NULL DEFAULT 0&lt;br&gt;source TEXT NOT NULL DEFAULT 'youtube' CHECK(source IN ('youtube','local'))&lt;br&gt;rating INTEGER NOT NULL DEFAULT 0 CHECK(rating BETWEEN 0 AND 10)&lt;br&gt;mimeType TEXT NULL&lt;br&gt;sizeBytes INTEGER NULL" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#5C4B70;strokeWidth=2;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="420" y="480" width="500" height="320" as="geometry" /></mxCell>
        <mxCell id="indexes" value="&lt;b&gt;Indexes&lt;/b&gt;&lt;br&gt;idx_playlists_user(userId, position)&lt;br&gt;idx_songs_playlist(playlistId, position)&lt;br&gt;idx_favorites_user(userId, id DESC)" style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#F3EAF4;strokeColor=#5C4B70;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="285" height="140" as="geometry" /></mxCell>
        <mxCell id="migration" value="&lt;b&gt;Migration guarantees&lt;/b&gt;&lt;br&gt;v1 rebuilt legacy tables, enforced constraints and deduplicated favorites.&lt;br&gt;v2 purges orphaned legacy rows.&lt;br&gt;Startup enables foreign_keys and runs foreign_key_check transactionally." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#FFF9FD;strokeColor=#C6005C;fontColor=#241733;" vertex="1" parent="1"><mxGeometry x="965" y="500" width="285" height="180" as="geometry" /></mxCell>
        <mxCell id="r1" value="1                              0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;endArrow=ERmany;strokeColor=#046E7D;strokeWidth=2;" edge="1" parent="1" source="users" target="playlists"><mxGeometry relative="1" as="geometry" /></mxCell>
