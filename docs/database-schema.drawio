        <mxCell id="r3" value="1                              0..* · cascade" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;endArrow=ERmany;strokeColor=#046E7D;strokeWidth=2;" edge="1" parent="1" source="playlists" target="songs"><mxGeometry relative="1" as="geometry" /></mxCell>
