{
    "name": "music-hub",
    "version": "1.0.0",
    "description": "Music Hub Final Project",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "test": "node --test \"tests/*.test.js\"",
        "lint": "node scripts/lint.js",
        "format": "prettier --write . --ignore-unknown",
        "format:check": "prettier --check . --ignore-unknown",
        "audit:prod": "npm audit --omit=dev",
        "backup": "node scripts/backup-data.js",
        "restore": "node scripts/restore-data.js",
        "uploads:reconcile": "node scripts/reconcile-uploads.js",
        "uploads:reconcile:delete": "node scripts/reconcile-uploads.js --delete"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^3.0.2",
        "connect-sqlite3": "^0.9.13",
        "csrf-sync": "^4.2.1",
        "dotenv": "^17.2.3",
        "ejs": "^3.1.9",
        "express": "^4.21.2",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.18.1",
        "file-type": "^21.1.0",
        "helmet": "^8.1.0",
        "multer": "^2.0.1",
        "sqlite3": "^6.0.1"
    },
    "devDependencies": {
        "eslint": "^9.39.0",
        "globals": "^16.5.0",
        "prettier": "^3.6.0"
    },
    "overrides": {
        "connect-sqlite3": {
            "sqlite3": "$sqlite3"
        }
    },
    "engines": {
        "node": ">=24.18.0 <25"
    }
}
