# Copy this file to `.env` and fill in real values. Never commit the real .env.

# Port the server listens on (optional; defaults to 3000)
PORT=3000

# Secret used to sign session cookies.
# REQUIRED in production: the server refuses to start without one, and it must be
# at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Optional comma-separated previous secrets during a controlled rotation.
# SESSION_SECRET_PREVIOUS=old-secret-at-least-32-characters-long

# YouTube Data API v3 key, used for music search.
# Without it the app still runs; search simply returns nothing.
# Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Set to "production" on the host to enable secure cookies, HSTS, and proxy trust.
# NODE_ENV=production

# --- Optional: durable storage paths -------------------------------------
# Point these at a persistent disk mount so a redeploy does not wipe user data.
# DB_PATH=/var/data/music_app.sqlite
# SESSION_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads
# BACKUP_DIR=/var/data/backups

# --- Optional: tuning ----------------------------------------------------
# BCRYPT_ROUNDS=10
# UPLOAD_MAX_BYTES=26214400
# UPLOAD_MAX_BYTES_PER_USER=524288000
# YOUTUBE_TIMEOUT_MS=5000
# YOUTUBE_CACHE_TTL_MS=300000
