<%- include('partials/layout-head', { title, user: null, active: 'home', bodyClass: 'app-shell' }) %>

<main id="main-content" class="app-main page-frame auth-layout">

    <section class="auth-panel order-1 order-md-2" aria-labelledby="register-title">
        <h1 class="page-title mb-4" id="register-title">Start with one track worth keeping.</h1>
        <p class="body-copy mb-4">Create your private library, then build the queue from there.</p>

        <%- include('partials/form-error', { error }) %>

        <form action="/register" method="POST" class="auth-panel__form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="row g-3">
                <div class="col-6">
                    <label for="firstName" class="field-label">First name</label>
                    <input type="text" id="firstName" name="firstName" class="form-control"
                           value="<%= values.firstName || '' %>" maxlength="<%= config.auth.maxNameLength %>"
                           autocomplete="given-name" required>
                </div>
                <div class="col-6">
                    <label for="lastName" class="field-label">Last name</label>
                    <input type="text" id="lastName" name="lastName" class="form-control"
                           value="<%= values.lastName || '' %>" maxlength="<%= config.auth.maxNameLength %>"
                           autocomplete="family-name">
                </div>
            </div>

            <div>
                <label for="username" class="field-label">Email</label>
                <input type="email" id="username" name="username" class="form-control"
                       value="<%= values.email || '' %>" maxlength="<%= config.auth.maxEmailLength %>"
                       autocomplete="username" required
                       <%= error ? 'aria-invalid="true"' : '' %>>
            </div>

            <div>
                <label for="password" class="field-label">Password</label>
                <%# minlength renders from the same server constant AuthService validates
                    against, so the client and server cannot drift apart. %>
                <input type="password" id="password" name="password" class="form-control"
                       autocomplete="new-password" minlength="<%= config.auth.minPasswordLength %>"
                       maxlength="<%= config.auth.maxPasswordLength %>"
                       aria-describedby="passwordHelp" required>
                <p class="field-help" id="passwordHelp">
                    <%= config.auth.minPasswordLength %>–<%= config.auth.maxPasswordLength %> characters; avoid commonly used passwords.
                </p>
            </div>

            <button type="submit" class="action-primary w-100">Build my first mix</button>
        </form>

        <p class="auth-footer-prompt mt-4 mb-0">
            Already have a library? <a class="action-link" href="/login">Open it.</a>
        </p>
    </section>

    <%- include('partials/auth-statement', {
        id: 'register-statement',
        eyebrow: 'Start a listening room',
        heading: 'Your finds and your files, in one set you control.',
        body: 'Search YouTube, keep the tracks worth returning to, add your own audio, and reorder the queue while it plays.'
    }) %>
</main>

<%- include('partials/layout-foot', { user, active: 'home' }) %>
