<%- include('../partials/layout-head', {
        title, user, active: 'playlists',
        bodyClass: 'app-shell player-shell',
        bodyAttrs: `data-has-playlists="true" data-has-current-song="${currentSong ? 'true' : 'false'}"` }) %>

<%# Configuration for client/js/playlist.js travels in data-* attributes, so the CSP
    needs no 'unsafe-inline' for scripts. %>
<div id="playlistApp"
     data-playlist-id="<%= playlist.id %>"
     data-max-rating="<%= config.rating.max %>"
     data-current-song-id="<%= currentSong ? currentSong.id : '' %>"
     data-csrf="<%= csrfToken %>"
     hidden></div>

<div class="playlist-workspace app-main">

    <%# ---------------- PLAYLIST RAIL (desktop ≥1024px) ---------------- %>
    <aside class="playlist-rail desktop-playlist-rail rule-bottom" aria-labelledby="rail-title">
        <div class="rail-header">
            <h2 class="rail-title" id="rail-title">Your mixes</h2>
            <button class="icon-button" type="button" data-bs-toggle="modal" data-bs-target="#createModal"
                    aria-label="Create a new mix">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div id="playlist-sortable" class="custom-scrollbar">
            <%- include('../partials/playlist-links', { playlists, currentId: playlist.id, draggable: true }) %>
        </div>
    </aside>

    <%# ---------------- PLAYER COLUMN ---------------- %>
    <main id="main-content" class="player-column custom-scrollbar">

        <div class="workspace-masthead">
            <div class="d-flex align-items-center gap-3 min-w-0">
                <button class="icon-button d-lg-none" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#playlistDrawer" aria-controls="playlistDrawer"
                        aria-label="Show your mixes">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
                <div class="workspace-masthead__text">
                    <h1 class="workspace-masthead__title"><%= playlist.name %></h1>
                    <p class="meta-label text-muted-parchment mb-0">
                        <%= songs.length %> <%= songs.length === 1 ? 'track' : 'tracks' %>
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="icon-button" type="button" data-bs-toggle="modal" data-bs-target="#renameModal"
                        aria-label="Rename this mix">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
                <button class="icon-button icon-button--danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteModal"
                        aria-label="Delete this mix">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div class="page-primary-region">
            <div class="player-frame mt-4" id="playerArea">
                <div class="player-empty">
                    <p class="mb-0"><%= songs.length ? 'Pick a track to start the set.' : 'Your queue is quiet. Find a YouTube track or add local audio.' %></p>
                </div>
            </div>

            <%# Now-playing metadata sits below the player, left aligned. %>
            <div class="now-playing" id="nowPlaying" <%= currentSong ? '' : 'hidden' %>>
                <div class="now-playing-rule" id="nowPlayingRule" aria-hidden="true"></div>
                <span class="source-label <%= currentSong && currentSong.isLocal ? 'source-label--local' : 'source-label--youtube' %>"
                      id="nowPlayingSource">
                    <%= currentSong && currentSong.isLocal ? 'Local' : 'YT' %>
                </span>
                <p class="now-playing__title" id="nowPlayingTitle"><%= currentSong ? currentSong.title : '' %></p>
            </div>

            <%# Transport only. Search and upload are separate modules below. %>
            <div class="transport">
                <button id="btnPrev" type="button" class="icon-button" aria-label="Previous track" disabled>
                    <i class="bi bi-skip-start-fill" aria-hidden="true"></i>
                </button>
                <button id="btnPlayAll" type="button" class="transport__play" <%= songs.length ? '' : 'disabled' %>>
                    <i class="bi bi-play-fill" aria-hidden="true"></i>
                    <span>Start the set</span>
                </button>
                <button id="btnNext" type="button" class="icon-button" aria-label="Next track" disabled>
                    <i class="bi bi-skip-end-fill" aria-hidden="true"></i>
                </button>
            </div>

            <%# Two collapsible editorial modules. %>
            <section class="editorial-module editorial-module--search" aria-labelledby="find-tracks-title">
                <h2 class="m-0">
                    <button class="editorial-module__trigger" type="button" data-bs-toggle="collapse"
                            data-bs-target="#findTracks" aria-expanded="false" aria-controls="findTracks"
                            id="find-tracks-title">
                        <span>Find tracks</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </button>
                </h2>
                <div class="collapse editorial-module__body" id="findTracks">
                    <form id="ytSearchForm" action="/playlists/<%= playlist.id %>" method="GET"
                          class="search-field" role="search">
                        <label for="ytSearchInput" class="visually-hidden">Search YouTube for music</label>
                        <input id="ytSearchInput" type="text" name="search" class="form-control"
                               placeholder="Artist, track, or mood" value="<%= searchQuery %>"
                               maxlength="<%= config.youtube.maxQueryLength %>" autocomplete="off">
                        <button class="action-primary" type="submit">Search YouTube</button>
                    </form>

                    <% if (searchError) { %>
                        <div class="form-alert form-alert--notice mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                            <span>YouTube didn't answer this time. Your saved tracks are still here.</span>
                        </div>
                    <% } %>

                    <div id="ytResults" class="track-ledger mt-3">
                        <% searchResults.forEach((result) => { %>
                            <%- include('../partials/search-result', { result, playlistId: playlist.id, csrfToken }) %>
                        <% }) %>
                    </div>
                </div>
            </section>

            <section class="editorial-module editorial-module--upload" aria-labelledby="add-local-title">
                <h2 class="m-0">
                    <button class="editorial-module__trigger" type="button" data-bs-toggle="collapse"
                            data-bs-target="#addLocal" aria-expanded="false" aria-controls="addLocal"
                            id="add-local-title">
                        <span>Add local audio</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </button>
                </h2>
                <div class="collapse editorial-module__body" id="addLocal">
                    <form action="/playlists/<%= playlist.id %>/upload" method="POST"
                          enctype="multipart/form-data" class="stack-4">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div>
                            <label for="uploadFile" class="field-label">Audio file</label>
                            <input type="file" id="uploadFile" name="mp3file" class="form-control"
                                   accept="<%= config.uploads.acceptAttribute %>" required
                                   aria-describedby="uploadHelp">
                            <%# Accepted formats and size limit stated BEFORE selection. %>
                            <p class="field-help" id="uploadHelp">
                                MP3, M4A, OGG, WAV, FLAC, or AAC — up to
                                <%= Math.round(config.uploads.maxBytes / 1024 / 1024) %> MB.
                            </p>
                        </div>
                        <div>
                            <label for="uploadTitle" class="field-label">Track title (optional)</label>
                            <input type="text" id="uploadTitle" name="title" class="form-control"
                                   maxlength="<%= config.uploads.maxTitleLength %>">
                        </div>
                        <button class="action-primary align-self-start" type="submit">Add to this mix</button>
                    </form>
                </div>
            </section>
        </div>
    </main>

    <%# ---------------- QUEUE PANEL (desktop) ---------------- %>
    <aside class="queue-panel desktop-queue-panel custom-scrollbar" aria-labelledby="queue-title">
        <div class="queue-header">
            <h2 class="queue-title" id="queue-title">
                Queue <span class="text-muted-parchment" id="songCountBadge"><%= songs.length %></span>
            </h2>
            <button class="icon-button" type="button" data-bs-toggle="collapse" data-bs-target="#queueTools"
                    aria-expanded="false" aria-controls="queueTools" aria-label="Filter and sort the queue">
                <i class="bi bi-sliders" aria-hidden="true"></i>
            </button>
        </div>

        <%# Filter/sort open in a compact panel rather than permanently consuming the header. %>
        <div class="collapse px-4 py-3 rule-bottom" id="queueTools">
            <label for="playlistFilter" class="field-label">Filter this queue</label>
            <input type="text" id="playlistFilter" class="form-control mb-3" placeholder="Track title">
            <label for="sortSelect" class="field-label">Order</label>
            <select id="sortSelect" class="form-select">
                <option value="default">The order you set</option>
                <option value="name_asc">Title A–Z</option>
                <option value="rating_desc">Highest rated</option>
            </select>
        </div>

        <ul class="queue-list" id="playlistQueue">
            <li class="queue-empty" id="queueEmptyState" <%= songs.length ? 'hidden' : '' %>>
                <span class="queue-empty__marker" aria-hidden="true">00 / standby</span>
                <p class="queue-empty__title">Your queue is ready.</p>
                <p class="queue-empty__copy">Find a track and it will appear here, ready to play.</p>
                <button class="action-secondary" type="button"
                        data-open-library-module="#findTracks" data-focus-target="#ytSearchInput">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    Find a track
                </button>
            </li>
            <li class="queue-empty queue-empty--filter" id="queueFilterEmpty" hidden>
                <span class="queue-empty__marker" aria-hidden="true">No signal</span>
                <p class="queue-empty__title">No tracks match that filter.</p>
                <button class="action-quiet" type="button" id="clearQueueFilter">Clear filter</button>
            </li>
            <% songs.forEach((song) => { %>
                <%- include('../partials/queue-item', {
                        song, playlistId: playlist.id, maxRating: config.rating.max,
                        csrfToken, isCurrent: currentSong && song.id === currentSong.id }) %>
            <% }) %>
        </ul>

    </aside>
</div>

<%# ---------------- MOBILE MINI PLAYER ---------------- %>
<div class="mobile-mini-player" id="miniPlayer">
    <span class="queue-item__art" aria-hidden="true">
        <span class="local-thumb" id="miniPlayerArt"><i class="bi bi-music-note-beamed"></i></span>
    </span>
    <div class="min-w-0">
        <p class="mobile-mini-player__title mb-0" id="miniPlayerTitle"></p>
        <span class="source-label source-label--youtube" id="miniPlayerSource">YT</span>
    </div>
    <div class="mobile-mini-player__controls" aria-label="Playback controls">
        <button type="button" class="icon-button icon-button--bare" id="miniPlayerPrev"
                aria-label="Previous track" disabled>
            <i class="bi bi-skip-start-fill" aria-hidden="true"></i>
        </button>
        <button type="button" class="icon-button mobile-mini-player__toggle" id="miniPlayerToggle"
                aria-label="Play" disabled>
            <i class="bi bi-play-fill" id="miniPlayerToggleIcon" aria-hidden="true"></i>
        </button>
        <button type="button" class="icon-button icon-button--bare" id="miniPlayerNext"
                aria-label="Next track" disabled>
            <i class="bi bi-skip-end-fill" aria-hidden="true"></i>
        </button>
    </div>
</div>

<%# ---------------- TEMPLATES ---------------- %>
<template id="queueItemTemplate">
    <%- include('../partials/queue-item', {
            song: { id: '', title: '', rating: 0, source: 'youtube', videoId: '', thumbnailUrl: '' },
            playlistId: playlist.id, maxRating: config.rating.max, csrfToken, isCurrent: false }) %>
</template>

<template id="searchResultTemplate">
    <%- include('../partials/search-result', {
            result: { videoId: '', title: '', thumbnail: '' },
            playlistId: playlist.id, csrfToken }) %>
</template>

<%# ---------------- SHEETS AND DIALOGS ---------------- %>
<%- include('../partials/create-playlist-modal') %>

<div class="modal fade" id="renameModal" tabindex="-1" aria-labelledby="renameModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/playlists/rename" method="POST" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <h2 class="modal-title" id="renameModalLabel">Give this mix a new name</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" value="<%= playlist.id %>">
                <label for="renamePlaylistInput" class="field-label">Mix name</label>
                <input type="text" id="renamePlaylistInput" name="name" class="form-control"
                       value="<%= playlist.name %>" maxlength="<%= config.playlists.maxNameLength %>" required>
            </div>
            <div class="modal-footer">
                <button type="button" class="action-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="action-primary">Keep the new name</button>
            </div>
        </form>
    </div>
</div>

<%# Destructive confirmation names the affected mix and states permanence. %>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/playlists/delete" method="POST" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <h2 class="modal-title" id="deleteModalLabel">Delete &ldquo;<%= playlist.name %>&rdquo;?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" value="<%= playlist.id %>">
                <p class="body-copy mb-0">
                    The playlist and its queue will be removed. Uploaded audio follows the
                    application's existing cleanup policy.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="action-secondary" data-bs-dismiss="modal">Keep this mix</button>
                <button type="submit" class="action-primary action-danger">Delete this mix</button>
            </div>
        </form>
    </div>
</div>

<%# Rating sheet — a real range input replacing ten tiny star buttons. %>
<div class="offcanvas offcanvas-bottom" tabindex="-1" id="ratingSheet" aria-labelledby="ratingSheetLabel">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="ratingSheetLabel">Rate this track</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form action="/playlists/<%= playlist.id %>/rate" method="POST" id="ratingForm" class="stack-6">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="songId" id="ratingSongId">

            <p class="page-title mb-0" id="ratingTrackTitle"></p>

            <p class="rating-sheet__value mb-0" id="ratingValueDisplay" aria-hidden="true">0</p>

            <div>
                <label for="ratingRange" class="visually-hidden">Rating out of <%= config.rating.max %></label>
                <input type="range" class="rating-range" id="ratingRange" name="rating"
                       min="<%= config.rating.min %>" max="<%= config.rating.max %>" step="1" value="0">
                <p class="rating-sheet__endpoints mt-2 mb-0">
                    <span>Not for me</span>
                    <span>Essential</span>
                </p>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <button type="submit" class="action-primary flex-grow-1">Keep this rating</button>
                <button type="button" class="action-secondary" id="ratingClear">Clear rating</button>
            </div>
        </form>
    </div>
</div>

<%# Mobile queue sheet — the same rows, moved into a bottom sheet under 768px. %>
<div class="offcanvas offcanvas-bottom" tabindex="-1" id="queueSheet" aria-labelledby="queueSheetLabel">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="queueSheetLabel">
            Queue <span class="text-muted-parchment" id="mobileSongCountBadge"><%= songs.length %></span>
        </h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0" id="queueSheetBody">
        <%# playlist.js moves the live queue list in here when the sheet opens, so the
            rows are never duplicated in the DOM. %>
    </div>
</div>

<div class="offcanvas offcanvas-start" tabindex="-1" id="playlistDrawer" aria-labelledby="playlistDrawerLabel">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="playlistDrawerLabel">Your mixes</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div class="p-3">
            <button class="action-secondary w-100" type="button" data-bs-toggle="modal" data-bs-target="#createModal">
                Create a new mix
            </button>
        </div>
        <%- include('../partials/playlist-links', { playlists, currentId: playlist.id, draggable: false }) %>
    </div>
</div>

<%- include('../partials/layout-foot', { user, active: 'playlists', pageScript: '/js/playlist.js', queueAvailable: true }) %>
