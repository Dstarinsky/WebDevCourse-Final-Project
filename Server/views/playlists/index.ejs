<%- include('../partials/layout-head', { title, user, active: 'playlists', bodyClass: 'app-shell' }) %>

<main id="main-content" class="app-main page-frame">

    <%# First-run state: a large serif folio and a real explanation, not a giant
        icon in a circle. %>
    <div class="empty-editorial">
        <div class="empty-editorial__head">
            <p class="folio-display mb-0" aria-hidden="true">01</p>
            <div>
                <h1 class="section-title">Name your first mix</h1>
                <p class="body-copy mt-3">
                    Start with a name. You can pull in YouTube finds or add your own audio next.
                </p>
            </div>
        </div>

        <div class="hero-actions">
            <button type="button" class="action-primary" data-bs-toggle="modal" data-bs-target="#createModal">
                Create my first mix
            </button>
        </div>

        <%# Explanatory figure showing what a mix looks like — clearly a sample. %>
        <figure class="m-0" aria-labelledby="sample-caption">
            <figcaption class="meta-label text-muted-parchment mb-2" id="sample-caption">
                What a mix looks like
            </figcaption>
            <ul class="sample-list">
                <li>
                    <span class="track-index" aria-hidden="true">01</span>
                    <span>A track you found on YouTube</span>
                    <span class="source-label source-label--youtube">YT</span>
                </li>
                <li>
                    <span class="track-index" aria-hidden="true">02</span>
                    <span>A file from your own library</span>
                    <span class="source-label source-label--local">Local</span>
                </li>
                <li>
                    <span class="track-index" aria-hidden="true">03</span>
                    <span>Whatever you keep next</span>
                    <span class="source-label source-label--youtube">YT</span>
                </li>
            </ul>
        </figure>
    </div>
</main>

<%- include('../partials/create-playlist-modal') %>

<%- include('../partials/layout-foot', { user, active: 'playlists' }) %>
