<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <%- include('../partials/head', { title: 'My Library' }) %>
</head>
<body class="app-shell">

    <%- include('../partials/navbar', { user, active: 'playlists' }) %>

    <div class="row g-0">
        
        <div class="col-md-3 col-lg-2 sidebar p-3 d-flex flex-column app-pane d-none d-md-flex">
            <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                <h6 class="label-caps text-readable-secondary mb-0">My Playlists</h6>
                <button class="btn btn-square" data-bs-toggle="modal" data-bs-target="#createModal" aria-label="Create playlist">
                    <i class="bi bi-plus fs-5"></i>
                </button>
            </div>

            <div class="d-flex flex-column gap-2 overflow-auto" style="flex: 1;">
                <p class="text-readable-secondary text-center mt-5 small">No playlists yet.</p>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 p-5 d-flex flex-column align-items-center justify-content-center text-center app-pane">
            <div class="bg-dark p-5 rounded-circle mb-4 shadow-lg border border-secondary border-opacity-25">
                <i class="bi bi-music-player display-1 text-secondary opacity-50"></i>
            </div>
            <h2 class="fw-bold text-white mb-2">Create Your First Playlist</h2>
            <p class="text-secondary mb-4">Organize your music by creating a new playlist.</p>
            <button class="btn btn-custom px-4" data-bs-toggle="modal" data-bs-target="#createModal">Create New Playlist</button>
        </div>

    </div>

    <div class="modal fade" id="createModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form action="/playlists/create" method="POST" class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">New Playlist</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="text" name="name" class="form-control" placeholder="Playlist Name" required>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="submit" class="btn btn-custom w-100">Create</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>