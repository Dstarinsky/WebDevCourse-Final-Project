<%# Shared by playlists/index.ejs and playlists/view.ejs. %>
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/playlists/create" method="POST" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <h2 class="modal-title" id="createModalLabel">Name this mix</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="body-copy mb-4">You can add YouTube tracks or your own audio once it exists.</p>
                <label for="newPlaylistNameInput" class="field-label">Mix name</label>
                <input type="text" id="newPlaylistNameInput" name="name" class="form-control"
                       placeholder="Late-night set" maxlength="<%= config.playlists.maxNameLength %>" required>
            </div>
            <div class="modal-footer">
                <button type="button" class="action-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="action-primary">Create this mix</button>
            </div>
        </form>
    </div>
</div>
