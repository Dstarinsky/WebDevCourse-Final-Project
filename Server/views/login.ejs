<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <%- include('partials/head', { title: 'Login - MyMusicApp' }) %>
</head>
<body class="d-flex flex-column min-vh-100">
    <%- include('partials/navbar', { user: null, active: 'home' }) %>

    <main class="flex-grow-1 d-flex align-items-center justify-content-center w-100 px-3 py-4">
    <div class="card card-profile p-4 shadow-lg border-0" style="max-width: 400px; width: 100%;">
        <div class="text-center mb-4">
            <h2 class="student-name">Welcome Back</h2>
            <p class="description">Please login to continue</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger text-center py-2" role="alert">
                <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3">
                <label for="username" class="form-label text-secondary fw-bold small">Username / Email</label>
                <input type="text" id="username" name="username" class="form-control" autocomplete="username" required>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label text-secondary fw-bold small">Password</label>
                <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
            </div>

            <button type="submit" class="btn btn-custom w-100 py-2">Login</button>
        </form>

        <div class="text-center mt-3">
            <p class="text-secondary small">New here? <a href="/register" class="text-decoration-none fw-bold" style="color: var(--color-neon);">Create an account</a></p>
        </div>
    </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>