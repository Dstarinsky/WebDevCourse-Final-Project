<%- include('partials/layout-head', { title, user: null, active: 'home', bodyClass: 'app-shell' }) %>

<main id="main-content" class="app-main page-frame auth-layout">

    <%# On mobile the form comes first (source order below), so the statement is
        placed second in the DOM and re-ordered on desktop by grid. %>
    <section class="auth-panel order-1 order-md-2" aria-labelledby="login-title">
        <h1 class="page-title mb-4" id="login-title">Your mixes are where you left them.</h1>
        <p class="body-copy mb-4">Sign in to keep listening and shaping the queue.</p>

        <%- include('partials/form-error', { error }) %>

        <form action="/login" method="POST" class="auth-panel__form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div>
                <label for="username" class="field-label">Email</label>
                <input type="email" id="username" name="username" class="form-control"
                       value="<%= values.email || '' %>" maxlength="<%= config.auth.maxEmailLength %>"
                       autocomplete="username" required
                       <%= error ? 'aria-invalid="true"' : '' %>>
            </div>

            <div>
                <label for="password" class="field-label">Password</label>
                <input type="password" id="password" name="password" class="form-control"
                       autocomplete="current-password" required>
            </div>

            <%# A passkey action belongs here once the backend supports one. Nothing
                non-functional is rendered in the meantime. %>

            <button type="submit" class="action-primary w-100">Open my library</button>
        </form>

        <p class="auth-footer-prompt mt-4 mb-0">
            New here? <a class="action-link" href="/register">Build your first mix.</a>
        </p>
    </section>

    <%- include('partials/auth-statement', {
        id: 'login-statement',
        eyebrow: 'Welcome back',
        heading: 'One queue for what you found and what you already had.',
        body: 'YouTube tracks and your own audio sit side by side, and editing the set never stops what is playing.'
    }) %>
</main>

<%- include('partials/layout-foot', { user, active: 'home' }) %>
