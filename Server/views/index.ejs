<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <%- include('partials/head', { title: 'Home - MyMusicApp' }) %>
</head>
<body>

    <%- include('partials/navbar', { user, active: 'home' }) %>

    <div class="hero-section text-center text-white d-flex flex-column justify-content-center align-items-center">
        <h1 class="display-3 fw-bold mb-3">Welcome to your Music Hub</h1>
        <p class="lead mb-5 text-secondary">Search for your favorite songs on YouTube and create your personal collection.</p>
        
        <div class="d-flex gap-3">
            <% if (user) { %>
                <a href="/favorites" class="btn btn-custom btn-lg shadow">
                    <i class="bi bi-search me-2"></i> Search Songs
                </a>
                <a href="/playlists" class="btn btn-outline-custom btn-lg shadow">
                    <i class="bi bi-music-note-list me-2"></i> Go to Playlists
                </a>
            <% } else { %>
                <a href="/login" class="btn btn-custom btn-lg shadow px-5">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Login to Start
                </a>
                <a href="/register" class="btn btn-outline-light btn-lg shadow px-5">
                    Create Account
                </a>
            <% } %>
        </div>
    </div>

    <footer class="social-footer">

        <div class="container d-flex flex-column align-items-center gap-3">

            <p class="small text-secondary mb-0">Connect with me</p>

            <div class="d-flex gap-3">

                <a href="https://github.com/Dstarinsky" target="_blank" rel="noopener" class="social-link" aria-label="GitHub profile">

                    <i class="bi bi-github fs-4"></i>

                </a>

                <a href="https://www.linkedin.com/in/david-starinsky/" target="_blank" rel="noopener" class="social-link" aria-label="LinkedIn profile">

                    <i class="bi bi-linkedin fs-4"></i>

                </a>

            </div>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>