<%- include('partials/layout-head', { title, user, active: 'favorites', bodyClass: 'app-shell' }) %>

<main id="main-content" class="app-main page-frame discover-layout">

    <%# Sticky intro column on desktop; one column below 1024px. %>
    <div class="discover-layout__intro page-masthead">
        <p class="page-masthead__eyebrow">Discover <span aria-hidden="true">/ 01</span></p>
        <h1 class="section-title" id="discover-title">Find something worth keeping</h1>

        <form action="/favorites" method="GET" class="search-field mt-3" role="search">
            <label for="favoritesSearch" class="visually-hidden">Search YouTube for music</label>
            <input type="text" id="favoritesSearch" name="search" class="form-control"
                   placeholder="Artist, track, or mood" value="<%= searchQuery %>"
                   maxlength="<%= config.youtube.maxQueryLength %>" autocomplete="off">
            <button type="submit" class="action-primary">Find tracks</button>
        </form>
    </div>

    <div class="page-primary-region">

        <% if (searchError) { %>
            <%# Upstream failure is stated distinctly from "no results", and the user's
                own library is explicitly still available. %>
            <div class="form-alert form-alert--notice mb-5" role="alert">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span>YouTube didn't answer this time. Your saved tracks are still here.</span>
            </div>
        <% } %>

        <% if (searchResults.length > 0) { %>
            <section aria-labelledby="results-title">
                <h2 class="visually-hidden" id="results-title">Search results</h2>

                <div class="track-ledger">
                    <% searchResults.forEach((video) => { %>
                        <article class="track-row">
                            <button type="button" class="track-row__media js-preview"
                                    data-video-id="<%= video.videoId %>"
                                    aria-label="Hear a preview of <%= video.title %>">
                                <img src="<%= video.thumbnail %>" alt="" loading="lazy">
                                <span class="track-row__media-overlay" aria-hidden="true">
                                    <i class="bi bi-play-fill"></i>
                                </span>
                            </button>

                            <div class="track-row__body">
                                <div class="track-row__meta">
                                    <span class="source-label source-label--youtube">YT</span>
                                    <% if (video.isFavorite) { %>
                                        <span class="source-label source-label--saved">Kept</span>
                                    <% } %>
                                </div>
                                <h3 class="track-row__title"><%= video.title %></h3>
                            </div>

                            <div class="track-row__actions">
                                <% if (video.isFavorite) { %>
                                    <button class="action-secondary" type="button" disabled>Kept</button>
                                <% } else { %>
                                    <form action="/favorites/add" method="POST" class="m-0">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="videoId" value="<%= video.videoId %>">
                                        <input type="hidden" name="title" value="<%= video.title %>">
                                        <input type="hidden" name="thumbnailUrl" value="<%= video.thumbnail %>">
                                        <input type="hidden" name="currentSearch" value="<%= searchQuery %>">
                                        <button class="action-secondary" type="submit">Keep this track</button>
                                    </form>
                                <% } %>

                                <button type="button" class="action-primary js-add-to-playlist"
                                        data-video-id="<%= video.videoId %>"
                                        data-title="<%= video.title %>"
                                        data-thumb="<%= video.thumbnail %>">Add to a mix</button>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </section>
        <% } else if (searchQuery && !searchError) { %>
            <p class="body-copy">
                Nothing matched that search. Try an artist, track, or a broader mood.
            </p>
        <% } %>

        <%# Large whitespace break, then the offset saved-tracks heading. %>
        <section class="section-break" aria-labelledby="saved-title">
            <div class="saved-heading d-flex align-items-baseline gap-3">
                <h2 class="section-title" id="saved-title">The ones you kept</h2>
                <span class="meta-label text-muted-parchment"><%= favorites.length %></span>
            </div>

            <% if (favorites.length === 0) { %>
                <p class="body-copy">No keepers yet. Search above and hold onto the first good one.</p>
            <% } else { %>
                <%# The irregular first-item span is only used with four or more items;
                    a small collection stays a clean grid. %>
                <div class="record-shelf" data-count="<%= favorites.length >= 4 ? 'many' : 'few' %>">
                    <% favorites.forEach((fav) => { %>
                        <article class="record-shelf__item">
                            <button type="button" class="record-shelf__media js-preview"
                                    data-video-id="<%= fav.videoId %>"
                                    aria-label="Hear a preview of <%= fav.title %>">
                                <img src="<%= fav.thumbnailUrl %>" alt="" loading="lazy">
                            </button>

                            <div class="d-flex align-items-center gap-2">
                                <span class="source-label source-label--youtube">YT</span>
                            </div>

                            <h3 class="record-shelf__title"><%= fav.title %></h3>

                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <button type="button" class="action-secondary js-add-to-playlist"
                                        data-video-id="<%= fav.videoId %>"
                                        data-title="<%= fav.title %>"
                                        data-thumb="<%= fav.thumbnailUrl || '' %>">Add to a mix</button>

                                <form action="/favorites/remove" method="POST" class="m-0">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="videoId" value="<%= fav.videoId %>">
                                    <input type="hidden" name="currentSearch" value="<%= searchQuery %>">
                                    <button class="icon-button icon-button--bare" type="submit"
                                            aria-label="Remove &ldquo;<%= fav.title %>&rdquo; from saved tracks">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </div>
</main>

<%# Config for client/js/favorites.js — data attributes, not an inline script. %>
<div id="favoritesApp" data-search="<%= searchQuery %>"
     data-added-playlist="<%= addedToPlaylistName || '' %>"
     data-added-playlist-id="<%= addedToPlaylistId || '' %>" hidden></div>

<div class="modal fade" id="addToPlaylistModal" tabindex="-1" aria-labelledby="addToPlaylistLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/playlists/add-from-search" method="POST" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <h2 class="modal-title" id="addToPlaylistLabel">Add to a mix</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="body-copy mb-4">Pick an existing mix, or start a new one for this track.</p>

                <input type="hidden" name="videoId" id="modalVideoId">
                <input type="hidden" name="title" id="modalTitle">
                <input type="hidden" name="thumbnailUrl" id="modalThumbnail">
                <input type="hidden" name="currentSearch" value="<%= searchQuery %>">

                <div class="mb-4">
                    <label for="existingSelect" class="field-label">Choose a mix</label>
                    <select name="existingPlaylistId" class="form-select" id="existingSelect">
                        <option value="" selected>Select one of your mixes</option>
                        <% playlists.forEach((p) => { %>
                            <option value="<%= p.id %>"><%= p.name %></option>
                        <% }) %>
                    </select>
                </div>

                <p class="meta-label text-muted-parchment mb-3">or</p>

                <div>
                    <label for="newInput" class="field-label">Start a new mix</label>
                    <input type="text" name="newPlaylistName" class="form-control"
                           placeholder="Late-night set" id="newInput"
                           maxlength="<%= config.playlists.maxNameLength %>">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="action-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="action-primary">Add to this mix</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="playModal" tabindex="-1" aria-labelledby="playModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="playModalLabel">Preview</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9">
                    <iframe id="previewIframe" src="" title="YouTube preview"
                            allow="autoplay; encrypted-media" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/layout-foot', { user, active: 'favorites', pageScript: '/js/favorites.js' }) %>
